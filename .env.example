# Copy this file to .env. Never commit the resulting .env file.
# Generate INTERNAL_API_KEY with: openssl rand -hex 32

HF_TOKEN=hf_replace_me
CIVITAI_API_TOKEN=replace_me
INTERNAL_API_KEY=replace_with_at_least_32_random_characters

# Absolute host path with at least 500 GB of fast local storage.
MODEL_CACHE_DIR=/srv/private-model-hosting/models

# Keep loopback unless a private reverse proxy on another host must connect.
PRIVATE_BIND_ADDRESS=127.0.0.1

# Admission controls. Tune only after running the included benchmarks.
LLM_MAX_RUNNING_REQUESTS=8
LLM_MAX_QUEUED_REQUESTS=128
VLM_CONTEXT_LENGTH=128000
VLM_MAX_RUNNING_REQUESTS=16
VLM_MAX_QUEUED_REQUESTS=64
QWEN_IMAGE_MAX_NUM_SEQS=3
LUSTIFY_MAX_QUEUE_SIZE=32
HUNYUAN3D_MAX_QUEUE_SIZE=16

# Per-request limits for the LUSTIFY shim.
LUSTIFY_JOB_TIMEOUT_SECONDS=900
LUSTIFY_MAX_MEGAPIXELS=4
LUSTIFY_MAX_IMAGES_PER_REQUEST=4

# Per-request limits and idle-unload timing for the Hunyuan3D-2 shim.
HUNYUAN3D_JOB_TIMEOUT_SECONDS=1200
HUNYUAN3D_IDLE_UNLOAD_SECONDS=600
HUNYUAN3D_MAX_IMAGE_BYTES=20971520
# Compose-internal URL for Hunyuan3D-2's text-to-3D text->image step. Only
# reachable if image-qwen (profile "research") is also running.
IMAGE_QWEN_BASE_URL=http://image-qwen:8000

# LUSTIFY is in Compose's "restricted" profile. Do not enable it for paid or
# public traffic until the licenses and required safety controls are approved.
# Hunyuan3D-2 is in Compose's "gated" profile for a different reason (MAU
# threshold + geo-exclusion, not NSFW/safety) - see docs/LICENSES.md. Its
# text-to-3D path additionally inherits image-qwen's non-commercial
# restriction until Qwen Image's commercial license clears.
